# ── Luna AI — Environment Variables ──────────────────────────────────────────
# Copy this file to .env and fill in values before running locally.
# Never commit .env to git.

# ── Server ────────────────────────────────────────────────────────────────────
APP_ENV=development          # development | production
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# ── Telnyx ───────────────────────────────────────────────────────────────────
TELNYX_API_KEY=              # From telnyx.com → API Keys
TELNYX_PHONE_NUMBER=         # E.164, e.g. +16284321017

# ── Twilio ────────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=          # From console.twilio.com
TWILIO_AUTH_TOKEN=           # From console.twilio.com
TWILIO_PHONE_NUMBER=         # E.164, e.g. +14155552671

# Set to true only in production with a real ngrok/public URL.
# Leave false in development and all test environments.
TWILIO_VALIDATE_SIGNATURES=false

# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_MAX_TOKENS=1024

# Set to true to enable real Claude planning. Requires ANTHROPIC_API_KEY.
# Leave false in development and all test environments.
USE_CLAUDE_PLANNER=false

# ── Scheduler (not used until v0.0.8) ────────────────────────────────────────
SCHEDULER_POLL_INTERVAL_SECONDS=120   # 2 minutes for demo; slower for prod

# ── Weather ───────────────────────────────────────────────────────────────────
# "mock": fixture data, no network (default for tests/dev)
# "open_meteo": real Open-Meteo API, no API key required
WEATHER_PROVIDER=mock

# ── Persistence ──────────────────────────────────────────────────────────────
# in_memory: no disk writes, state lost on restart (default for tests/CI)
# sqlite:    persists to a local file, survives restarts
LUNA_MEMORY_BACKEND=in_memory
LUNA_DB_PATH=./data/luna.db
