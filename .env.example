# ── Luna AI — Environment Variables ──────────────────────────────────────────
# Copy this file to .env and fill in values before running locally.
# Never commit .env to git.

# ── Server ────────────────────────────────────────────────────────────────────
APP_ENV=development          # development | production
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# ── Twilio (not used in v0.0.1 — fill in before v0.0.3) ──────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=         # e.g. +14155552671

# ── Anthropic (not used in v0.0.1 — fill in before v0.0.3) ──────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── Scheduler (not used until v0.0.8) ────────────────────────────────────────
SCHEDULER_POLL_INTERVAL_SECONDS=120   # 2 minutes for demo; slower for prod

# ── Storage (in-memory for v0.1; swap for DB URL later) ──────────────────────
STORAGE_BACKEND=memory        # memory | sqlite | postgres
DATABASE_URL=                 # e.g. postgresql://user:pass@localhost/luna
